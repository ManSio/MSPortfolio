{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": ["./**/*.ts", "../src/lib/mcp-tools.ts", "../src/lib/types.ts", "../src/data/**/*.json"]
}
